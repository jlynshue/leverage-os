# AWS Configuration for Bedrock
# Ensure AWS credentials are configured via aws configure or environment variables
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Analytical engine selection. Built-in: bedrock (default), manual (no-AI).
# See docs/SCAFFOLDING.md §7 for the LLMProvider seam.
LEVERAGE_OS_PROVIDER=bedrock
# LEVERAGE_OS_PROVIDER=manual    # forces filled-prompt fallback (no API calls)
# LEVERAGE_OS_PROVIDER=openai    # reserved for M4 — not yet implemented
